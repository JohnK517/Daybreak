<Window x:Class="daybreak.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:daybreak"
        mc:Ignorable="d"
        Title="Daybreak"
        Width="1280"
        Height="720"
        WindowState="Maximized"
        ResizeMode="NoResize"
        WindowStyle="None">
    <Grid>
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="33*" />
                <ColumnDefinition Width="287*"/>
                <ColumnDefinition Width="320*" />
            </Grid.ColumnDefinitions>

            <!-- **************************************************************************** -->

            <!-- Widgets Panel -->
            <Border Grid.Row="0"
             Grid.Column="0"
             Grid.RowSpan="3"
             Margin="0,0,0,0"
             Background="#263359"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Grid.ColumnSpan="2"/>

            <!-- Date -->
            <TextBlock
            x:Name="DateTextBlock"
            Text="Monday, July 20"
            FontSize="32"
            Foreground="Silver"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="65,65,0,0" Grid.ColumnSpan="2" Grid.RowSpan="3"/>

            <!-- Time -->
            <TextBlock
            x:Name="TimeTextBlock"
            Text="08:08 AM"
            FontSize="80"
            Foreground="White"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="60,100,0,0" Grid.ColumnSpan="2" Grid.RowSpan="3"/>

            <!-- Ticker Box -->
            <Border
            Height="460"
            Width="375"
            Grid.RowSpan="3"
            Background="DarkGray"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="-25,225,0,0" Grid.Column="1"/>

            <!-- Ticker Reminders -->
            <TextBlock
            Text="Reminders"
            TextDecorations="Underline"
            FontSize="24"
            Grid.RowSpan="3"
            Foreground="White"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="4,225,0,0" Grid.Column="1"/>

            <TextBlock
            Text="• Task 1&#10;• Task 2&#10;• Task 3"
            FontSize="24"
            Height="340"
            Width="250"
            Grid.RowSpan="3"
            Foreground="White"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="4,255,0,0" Grid.Column="1"/>

            <!-- Ticker Notifications -->
            <TextBlock
            Text="Notifications"
            FontSize="24"
            TextDecorations="Underline"
            Grid.RowSpan="3"
            Foreground="White"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="4,360,0,0" Grid.Column="1"/>

            <TextBlock
            Text="⬜ - Brother&#10;⬜ - Mom"
            FontSize="24"
            Foreground="White"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="4,390,0,0" Grid.Column="1" Grid.RowSpan="3"/>

            <!-- Ticker Sports -->
            <TextBlock
            Text="Sports"
            TextDecorations="Underline"
            FontSize="24"
            Foreground="White"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="4,465,0,0" Grid.Column="1" Grid.RowSpan="3"/>

            <TextBlock
            Text="Blackhawks Game&#10;CHI 1-0 NYR"
            FontSize="24"
            Foreground="White"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="4,495,0,0" Grid.Column="1" Grid.RowSpan="3"/>

            <!-- Clouds -->
            <StackPanel
            Grid.Column="1"
            Grid.RowSpan="3"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="400,115,0,0">

                <TextBlock
                Text="☁"
                FontSize="55"
                Foreground="White"
                TextAlignment="Center"
                HorizontalAlignment="Center"/>

                <TextBlock
                Text="Thunderstorms&#10;Cloudy"
                FontSize="14"
                Foreground="White"
                TextAlignment="Center"
                HorizontalAlignment="Center"
                Margin="0,-10,0,0"/>

            </StackPanel>

            <!-- Temperature -->
            <TextBlock
            Text="86°F"
            FontSize="80"
            Foreground="White"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="500,100,0,0" Grid.Column="1" Grid.RowSpan="3"/>

            <!-- High Temperature -->
            <TextBlock
            Text="H: 188°F"
            FontSize="28"
            Foreground="Silver"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="415,220,0,0" Grid.Column="1" Grid.RowSpan="3"/>

            <!-- Low Temperature -->
            <TextBlock
            Text="L: 188°F"
            FontSize="28"
            Foreground="Silver"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="560,220,0,0" Grid.Column="1" Grid.RowSpan="3"/>

            <!-- 7 Day Forecast -->
            <Grid Grid.Column="1"
              Grid.RowSpan="3"
              Margin="400,290,0,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Top">

                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <!-- 7-Day Forecast - Day 1 -->
                <TextBlock Text="Today"
               Grid.Row="0"
               Grid.Column="0"
               FontSize="28"
               Foreground="White"/>

                <TextBlock Text="☁"
               Grid.Row="0"
               Grid.Column="1"
               FontSize="28"
               Foreground="White"/>

                <TextBlock Text="70°F - 92°F"
               Grid.Row="0"
               Grid.Column="2"
               FontSize="28"
               Foreground="White"/>

                <!-- 7-Day Forecast - Day 2 -->
                <TextBlock Text="Tue"
               Grid.Row="1"
               Grid.Column="0"
               FontSize="28"
               Foreground="White"/>

                <TextBlock Text="☁"
               Grid.Row="1"
               Grid.Column="1"
               FontSize="28"
               Foreground="White"/>

                <TextBlock Text="70°F - 75°F"
               Grid.Row="1"
               Grid.Column="2"
               FontSize="28"
               Foreground="White"/>

                <!-- 7-Day Forecast - Day 3 -->
                <TextBlock Text="Wed"
               Grid.Row="2"
               Grid.Column="0"
               FontSize="28"
               Foreground="White"/>

                <TextBlock Text="☁"
               Grid.Row="2"
               Grid.Column="1"
               FontSize="28"
               Foreground="White"/>

                <TextBlock Text="70°F - 75°F"
               Grid.Row="2"
               Grid.Column="2"
               FontSize="28"
               Foreground="White"/>

                <!-- 7-Day Forecast - Day 4 -->
                <TextBlock Text="Thu"
               Grid.Row="3"
               Grid.Column="0"
               FontSize="28"
               Foreground="White"/>

                <TextBlock Text="☁"
               Grid.Row="3"
               Grid.Column="1"
               FontSize="28"
               Foreground="White"/>

                <TextBlock Text="70°F - 75°F"
               Grid.Row="3"
               Grid.Column="2"
               FontSize="28"
               Foreground="White"/>

                <!-- 7-Day Forecast - Day 5 -->
                <TextBlock Text="Fri"
               Grid.Row="4"
               Grid.Column="0"
               FontSize="28"
               Foreground="White"/>

                <TextBlock Text="☁"
               Grid.Row="4"
               Grid.Column="1"
               FontSize="28"
               Foreground="White"/>

                <TextBlock Text="70°F - 75°F"
               Grid.Row="4"
               Grid.Column="2"
               FontSize="28"
               Foreground="White"/>

                <!-- 7-Day Forecast - Day 6 -->
                <TextBlock Text="Sat"
               Grid.Row="5"
               Grid.Column="0"
               FontSize="28"
               Foreground="White"/>

                <TextBlock Text="☁"
               Grid.Row="5"
               Grid.Column="1"
               FontSize="28"
               Foreground="White"/>

                <TextBlock Text="70°F - 75°F"
               Grid.Row="5"
               Grid.Column="2"
               FontSize="28"
               Foreground="White"/>

                <!-- 7-Day Forecast - Day 7 -->
                <TextBlock Text="Sun"
               Grid.Row="6"
               Grid.Column="0"
               FontSize="28"
               Foreground="White"/>

                <TextBlock Text="☁"
               Grid.Row="6"
               Grid.Column="1"
               FontSize="28"
               Foreground="White"/>

                <TextBlock Text="70°F - 75°F"
               Grid.Row="6"
               Grid.Column="2"
               FontSize="28"
               Foreground="White"/>

            </Grid>

            <!-- Wake Timer -->
            <StackPanel
            Orientation="Vertical"
            Grid.Column="1"
            Grid.RowSpan="3"
            VerticalAlignment="Top"
            Margin="10,715,0,0">

                <!-- Wake Time -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                    Text="Wake Time: "
                    FontSize="32"
                    Foreground="White"
                    HorizontalAlignment="Left"/>

                    <TextBlock
                    x:Name="WakeTimeTextBlock"
                    Text="0:00 AM"
                    FontSize="32"
                    Foreground="White"
                    HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- Time Awake -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                    Text="Time Awake: "
                    FontSize="32"
                    Foreground="White"
                    HorizontalAlignment="Left"/>

                    <TextBlock
                    x:Name="TimeAwakeTextBlock"
                    Text="00:00:00"
                    FontSize="32"
                    Foreground="White"
                    HorizontalAlignment="Left"/>
                </StackPanel>

            </StackPanel>

            <!-- Wake Up Button -->
            <Grid
            Grid.Column="1"
            Grid.RowSpan="3"
            Margin="432,600,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">

                <Button
                x:Name="WakeButton"
                Width="160"
                Height="160"
                Click="WakeButton_Click"
                Margin="0,0,0,0">
                    <Button.Template>
                        <ControlTemplate
                        TargetType="Button">
                            <Border
                            CornerRadius="90"
                            Background="Transparent"
                            BorderBrush="White"
                            BorderThickness="4">
                                <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                    <TextBlock
                    Text="🔆"
                    FontSize="128"
                    Foreground="White"
                    Margin="-11,-16,0,0"/>
                </Button>

            </Grid>
            
            <TextBlock
            Text="Wake Up"
            FontSize="32"
            Foreground="White"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="448,755,0,0" Grid.RowSpan="3" Grid.Column="1"/>

            <!-- **************************************************************************** -->

            <!-- Media Panel -->
            <Border
             Grid.Column="2" Grid.RowSpan="2"
             Background="#7893e3"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Margin="0,0,0,0"/>

            <!-- Music Tab -->
            <TextBlock
            Text="Music"
            FontSize="28"
            Foreground="White"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="-375,40,0,0" Grid.Column="2" Grid.RowSpan="2"/>

            <!-- Sounds Tab -->
            <TextBlock
            Text="Sounds"
            FontSize="28"
            Foreground="White"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,40,0,0" Grid.Column="2" Grid.RowSpan="2"/>

            <!-- Books Tab -->
            <TextBlock
            Text="Books"
            FontSize="28"
            Foreground="White"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="375,40,0,0" Grid.Column="2" Grid.RowSpan="2"/>

            <!-- Media Image -->
            <TextBlock
            Text="⬜"
            FontSize="325"
            Foreground="White"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,-25,0,0" Grid.Column="2" Grid.RowSpan="2"/>

            <!-- Title -->
            <TextBlock
            Text="Title"
            FontSize="36"
            Foreground="White"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="105,325,0,0" Grid.Column="2" Grid.RowSpan="2"/>

            <!-- Author/Artist -->
            <TextBlock
            Text="Author/Artist"
            FontSize="20"
            Foreground="White"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="105,370,0,0" Grid.Column="2" Grid.RowSpan="2"/>

            <!-- Scrub Bar -->
            <TextBlock
            Text="------------------------------------------------------------------------------"
            FontSize="18"
            Foreground="White"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,400,0,0" Grid.Column="2" Grid.RowSpan="2"/>

            <!-- Current Time/Time Left -->
            <TextBlock
            Text="0:00"
            FontSize="18"
            Foreground="White"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="-600,400,0,0" Grid.Column="2" Grid.RowSpan="2"/>

            <!-- Total Time -->
            <TextBlock
            Text="9:99"
            FontSize="18"
            Foreground="White"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="600,400,0,0" Grid.Column="2" Grid.RowSpan="2"/>

            <!-- Play Button -->
            <TextBlock
            Text="▶"
            FontSize="78"
            Foreground="White"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,425,0,0" Grid.Column="2" Grid.RowSpan="2"/>

            <!-- Back Arrow -->
            <TextBlock
            Text="⏪︎"
            FontSize="78"
            Foreground="White"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="-200,425,0,0" Grid.Column="2" Grid.RowSpan="2"/>

            <!-- Forward Arrow -->
            <TextBlock
            Text="⏩︎"
            FontSize="78"
            Foreground="White"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="200,425,0,0" Grid.Column="2" Grid.RowSpan="2"/>

            <!-- **************************************************************************** -->

            <!-- Apps Panel -->
            <Border Grid.Row="2"
             Grid.Column="2"
             Background="LightGray"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Margin="0,0,0,0"/>

            <!-- Flow -->
            <StackPanel
                Grid.Column="2"
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False">

                <StackPanel.RenderTransform>
                    <TranslateTransform X="-225"/>
                </StackPanel.RenderTransform>

                <TextBlock
                    Text="⬜"
                    FontSize="128"
                    Foreground="White"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="Flow"
                    FontSize="32"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    Margin="0,-20,0,40"/>

            </StackPanel>

            <Button
                Grid.Column="2"
                Grid.Row="2"
                Click="Flow_Click"
                Width="91"
                Height="91"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderBrush="Transparent" Margin="0,75,0,0">

                <Button.RenderTransform>
                    <TranslateTransform X="-225"/>
                </Button.RenderTransform>

            </Button>

            <!-- Fuel -->
            <StackPanel
                Grid.Column="2"
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False">

                <StackPanel.RenderTransform>
                    <TranslateTransform X="-75"/>
                </StackPanel.RenderTransform>

                <TextBlock
                    Text="⬜"
                    FontSize="128"
                    Foreground="White"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="Fuel"
                    FontSize="32"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    Margin="0,-20,0,40"/>

            </StackPanel>

            <Button
                Grid.Column="2"
                Grid.Row="2"
                Click="Fuel_Click"
                Width="91"
                Height="91"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderBrush="Transparent" Margin="0,75,0,0">

                <Button.RenderTransform>
                    <TranslateTransform X="-75"/>
                </Button.RenderTransform>

            </Button>

            <!-- Form -->
            <StackPanel
                Grid.Column="2"
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False">

                <StackPanel.RenderTransform>
                    <TranslateTransform X="75"/>
                </StackPanel.RenderTransform>

                <TextBlock
                    Text="⬜"
                    FontSize="128"
                    Foreground="White"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="Form"
                    FontSize="32"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    Margin="0,-20,0,40"/>

            </StackPanel>

            <Button
                Grid.Column="2"
                Grid.Row="2"
                Click="Form_Click"
                Width="91"
                Height="91"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderBrush="Transparent" Margin="0,75,0,0">

                <Button.RenderTransform>
                    <TranslateTransform X="75"/>
                </Button.RenderTransform>

            </Button>

            <!-- Feel -->
            <StackPanel
                Grid.Column="2"
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False">

                <StackPanel.RenderTransform>
                    <TranslateTransform X="225"/>
                </StackPanel.RenderTransform>

                <TextBlock
                    Text="⬜"
                    FontSize="128"
                    Foreground="White"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="Feel"
                    FontSize="32"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    Margin="0,-20,0,40"/>

            </StackPanel>

            <Button
                Grid.Column="2"
                Grid.Row="2"
                Click="Feel_Click"
                Width="91"
                Height="91"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderBrush="Transparent" Margin="0,75,0,0">

                <Button.RenderTransform>
                    <TranslateTransform X="225"/>
                </Button.RenderTransform>

            </Button>

            <!-- Settings -->
            <TextBlock
            Text="⛭"
            FontSize="28"
            Foreground="White"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="500,225,0,0" Grid.Column="2" Grid.Row="2" Grid.RowSpan="1"/>

            <!-- Info -->
            <TextBlock
            Text="ⓘ"
            FontSize="28"
            Foreground="White"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="600,225,0,0" Grid.Column="2" Grid.Row="2" Grid.RowSpan="1"/>

            <!-- Exit -->
            <TextBlock
            Text="➜]"
            FontSize="28"
            Foreground="White"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="700,225,0,0" Grid.Column="2" Grid.Row="2" Grid.RowSpan="1"/>

            <Button
            Grid.Column="2"
            Grid.Row="2"
            Width="35"
            Height="35"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="700,229,0,0"
            Background="Transparent"
            BorderBrush="Transparent"
            Click="Exit_Click"/>

            <!-- **************************************************************************** -->

            <Frame x:Name="AppFrame"
                   NavigationUIVisibility="Hidden"
                   Grid.RowSpan="3"
                   Grid.ColumnSpan="3"/>

            <!-- **************************************************************************** -->

            <!-- Exit Overlay -->
            <Grid x:Name="ExitOverlay"
              Visibility="Collapsed"
              Background="#90000000"
              Grid.RowSpan="3"
              Grid.ColumnSpan="3"
              Panel.ZIndex="100">

                <Border
                Width="400"
                Height="200"
                Background="#263359"
                CornerRadius="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                    <StackPanel>

                        <TextBlock
                        Text="Are you sure you want to exit?"
                        FontSize="24"
                        Foreground="White"
                        HorizontalAlignment="Center"
                        Margin="0,40,0,40"/>

                        <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">

                            <Button
                            Content="Yes"
                            Width="100"
                            Height="40"
                            Margin="10"
                            Background="#7893e3"
                            Click="ExitYes_Click"/>

                            <Button
                            Content="No"
                            Width="100"
                            Height="40"
                            Margin="10"
                            Background="Silver"
                            Click="ExitNo_Click"/>

                        </StackPanel>

                    </StackPanel>

                </Border>

            </Grid>


        </Grid>
    </Grid>
</Window>
